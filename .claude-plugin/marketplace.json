{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "public-ai-skills",
  "owner": {
    "name": "code-better-life"
  },
  "description": "公开 AI Skill 仓库：集中托管可分享、可迁移的 skill，可作为 Claude Code 插件市场使用。",
  "plugins": [
    {
      "name": "document-conversion",
      "source": "./",
      "description": "文档转换技能集：docx → markdown、markdown → docx（含中国公文格式排版），以及基于 markitdown 的任意文件 → markdown。",
      "version": "1.2.0",
      "author": {
        "name": "code-better-life"
      },
      "homepage": "https://github.com/code-better-life/public-ai-skills",
      "repository": "https://github.com/code-better-life/public-ai-skills",
      "keywords": [
        "document",
        "docx",
        "pdf",
        "markdown",
        "conversion",
        "markitdown",
        "公文"
      ],
      "category": "productivity"
    },
    {
      "name": "tianyancha",
      "source": "./plugins/tianyancha",
      "description": "天眼查开放平台企业查询：工商信息、股东、对外投资、主要人员、诉讼与经营异常。需要自备天眼查开放平台 token，并在中国大陆网络环境下使用。",
      "version": "1.0.0",
      "author": {
        "name": "code-better-life"
      },
      "homepage": "https://github.com/code-better-life/public-ai-skills",
      "repository": "https://github.com/code-better-life/public-ai-skills",
      "keywords": [
        "tianyancha",
        "天眼查",
        "company",
        "工商",
        "api"
      ],
      "category": "productivity"
    }
  ]
}
